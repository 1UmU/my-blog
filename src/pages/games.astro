---
import Icon from "@/components/common/Icon.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const games = [
	{
		name: "扫雷",
		slug: "minesweeper",
		status: "已上线",
		statusTone: "live",
		description: "一款为桌面与手机设计的现代扫雷游戏。",
		meta: "初级 · 中级 · 专家",
		href: "https://game.voqz.de",
		action: "开始游戏",
		icon: "material-symbols:flag",
	},
	{
		name: "平面肉鸽",
		slug: "plane-roguelike",
		status: "开发中",
		statusTone: "building",
		description: "驾驶战机穿过随机房间，自动射击、获取升级并挑战 Boss。",
		meta: "Phaser 3 · TypeScript · M1 原型",
		href: "https://github.com/1UmU/plane-roguelike",
		action: "查看项目",
		icon: "fa6-brands:github",
	},
] as const;
---

<MainGridLayout title="游戏中心" description="从这里进入我制作和维护的小游戏。">
	<div class="games-page">
		<header class="games-intro">
			<div>
				<p class="games-kicker"><span>PLAYGROUND</span><span class="games-kicker-line" aria-hidden="true"></span><span>02 PROJECTS</span></p>
				<h1>游戏中心</h1>
				<p class="games-lede">把想法做成可以直接玩的东西。选择一个项目，开始游戏，或者看看它是怎样一步步长出来的。</p>
			</div>
			<div class="games-count" aria-label="游戏项目数量">
				<strong>02</strong>
				<span>PROJECTS</span>
			</div>
		</header>

		<div class="game-grid">
			{games.map((game) => (
				<article class:list={["game-card", `game-card-${game.statusTone}`]}>
					<div class:list={["game-visual", `game-visual-${game.slug}`]}>
						{game.slug === "minesweeper" ? (
							<img src="/assets/images/games/minesweeper.webp" alt="扫雷游戏棋盘预览" loading="lazy" />
						) : (
							<div class="plane-preview" aria-hidden="true">
								<div class="plane-grid"></div>
								<div class="plane-sight plane-sight-a"></div>
								<div class="plane-sight plane-sight-b"></div>
								<Icon icon="material-symbols:flight" size="2xl" class="plane-icon" />
								<span class="plane-coordinates">SECTOR 01 · M1</span>
							</div>
						)}
						<span class="game-status"><span class="status-dot" aria-hidden="true"></span>{game.status}</span>
					</div>
					<div class="game-body">
						<div class="game-heading">
							<div>
								<p class="game-index">0{games.indexOf(game) + 1}</p>
								<h2>{game.name}</h2>
							</div>
							<Icon icon={game.icon} size="xl" class="game-heading-icon" />
						</div>
						<p class="game-description">{game.description}</p>
						<p class="game-meta"><span class="meta-rule" aria-hidden="true"></span>{game.meta}</p>
						<div class="game-actions">
							{game.slug === "minesweeper" ? (
								<a class="game-action game-action-primary" href={game.href} target="_blank" rel="noopener noreferrer">
									<span>{game.action}</span>
									<Icon icon="material-symbols:arrow-outward" size="sm" />
								</a>
							) : (
								<a class="game-action game-action-secondary" href={game.href} target="_blank" rel="noopener noreferrer">
									<Icon icon={game.icon} size="sm" />
									<span>{game.action}</span>
									<Icon icon="material-symbols:arrow-outward" size="sm" />
								</a>
							)}
						</div>
					</div>
				</article>
			))}
		</div>

		<footer class="games-footer">
			<Icon icon="material-symbols:terminal" size="lg" />
			<p>游戏仍在持续更新，新的项目和开发日志会陆续加入这里。</p>
			<a href="/archive/">阅读开发记录 <Icon icon="material-symbols:arrow-forward" size="sm" /></a>
		</footer>
	</div>
</MainGridLayout>

<style>
	.games-page {
		width: 100%;
		padding: clamp(1.25rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2.5rem) 1.5rem;
	}

	.games-intro {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		padding: 0.25rem 0 2.25rem;
		border-bottom: 1px solid var(--line-divider);
	}

	.games-intro > div:first-child {
		min-width: 0;
	}

	.games-kicker {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0 0 0.9rem;
		color: var(--primary);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	.games-kicker-line {
		width: 2.5rem;
		height: 1px;
		background: var(--primary);
		opacity: 0.55;
	}

	.games-intro h1 {
		margin: 0;
		color: var(--deep-text);
		font-size: clamp(2rem, 4vw, 3.3rem);
		font-weight: 800;
		line-height: 1.05;
	}

	.games-lede {
		max-width: 38rem;
		overflow-wrap: anywhere;
		margin: 1rem 0 0;
		color: var(--btn-content);
		font-size: 0.98rem;
		line-height: 1.8;
	}

	.games-count {
		flex: 0 0 auto;
		padding-left: 1.25rem;
		border-left: 1px solid var(--line-divider);
		color: var(--btn-content);
		text-align: right;
	}

	.games-count strong,
	.games-count span {
		display: block;
	}

	.games-count strong {
		color: var(--primary);
		font-family: var(--font-family-code, monospace);
		font-size: 2.4rem;
		line-height: 1;
	}

	.games-count span {
		margin-top: 0.35rem;
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.12em;
	}

	.game-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1rem, 2.5vw, 1.75rem);
		padding: 2rem 0 1.5rem;
	}

	.game-card {
		min-width: 0;
		overflow: hidden;
		border: 1px solid var(--line-divider);
		border-radius: var(--radius-large);
		background: var(--card-bg);
		box-shadow: 0 0.75rem 2.25rem rgba(34, 49, 44, 0.07);
		transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
	}

	.game-card:hover {
		transform: translateY(-0.25rem);
		border-color: color-mix(in srgb, var(--primary) 60%, var(--line-divider));
		box-shadow: 0 1rem 2.5rem rgba(34, 49, 44, 0.12);
	}

	.game-visual {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--btn-regular-bg);
	}

	.game-visual img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: transform 500ms ease;
	}

	.game-card:hover .game-visual img {
		transform: scale(1.035);
	}

	.game-visual::after {
		position: absolute;
		inset: 0;
		content: "";
		background: linear-gradient(180deg, rgba(15, 27, 23, 0.03) 35%, rgba(15, 27, 23, 0.5) 100%);
		pointer-events: none;
	}

	.game-status {
		position: absolute;
		z-index: 1;
		top: 1rem;
		left: 1rem;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 0.65rem;
		border: 1px solid rgba(255, 255, 255, 0.27);
		border-radius: 999px;
		color: #fff;
		background: rgba(16, 28, 24, 0.58);
		font-size: 0.7rem;
		font-weight: 750;
		backdrop-filter: blur(8px);
	}

	.status-dot {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: #84d6a0;
		box-shadow: 0 0 0 3px rgba(132, 214, 160, 0.18);
	}

	.game-card-building .status-dot {
		background: #f2c94c;
		box-shadow: 0 0 0 3px rgba(242, 201, 76, 0.18);
	}

	.plane-preview {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background: #172b31;
		background-image: radial-gradient(circle at 75% 25%, rgba(77, 202, 185, 0.3), transparent 25%), linear-gradient(135deg, #15262c, #20454b 60%, #132027);
	}

	.plane-grid {
		position: absolute;
		inset: -30%;
		transform: rotate(-15deg);
		background-image: linear-gradient(rgba(152, 239, 215, 0.13) 1px, transparent 1px), linear-gradient(90deg, rgba(152, 239, 215, 0.13) 1px, transparent 1px);
		background-size: 2.2rem 2.2rem;
	}

	.plane-sight {
		position: absolute;
		width: 12rem;
		height: 12rem;
		border: 1px solid rgba(154, 236, 211, 0.45);
		border-radius: 50%;
	}

	.plane-sight::before,
	.plane-sight::after {
		position: absolute;
		content: "";
		background: rgba(154, 236, 211, 0.3);
	}

	.plane-sight::before {
		top: 50%;
		left: -1rem;
		width: calc(100% + 2rem);
		height: 1px;
	}

	.plane-sight::after {
		top: -1rem;
		left: 50%;
		width: 1px;
		height: calc(100% + 2rem);
	}

	.plane-sight-a {
		top: -5rem;
		right: -2rem;
	}

	.plane-sight-b {
		right: 22%;
		bottom: -9rem;
		width: 16rem;
		height: 16rem;
		opacity: 0.45;
	}

	.plane-icon {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 1;
		color: #a6f4dc;
		font-size: 4.5rem;
		transform: translate(-50%, -50%) rotate(-25deg);
		filter: drop-shadow(0 0 1rem rgba(125, 245, 213, 0.5));
	}

	.plane-coordinates {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		z-index: 1;
		color: rgba(198, 255, 238, 0.75);
		font-family: var(--font-family-code, monospace);
		font-size: 0.62rem;
		letter-spacing: 0.14em;
	}

	.game-body {
		padding: 1.3rem 1.4rem 1.45rem;
	}

	.game-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.game-index {
		margin: 0 0 0.2rem;
		color: var(--primary);
		font-family: var(--font-family-code, monospace);
		font-size: 0.68rem;
		font-weight: 800;
	}

	.game-heading h2 {
		margin: 0;
		color: var(--deep-text);
		font-size: 1.45rem;
		font-weight: 800;
	}

	.game-heading-icon {
		color: var(--primary);
	}

	.game-description {
		min-height: 3.2rem;
		margin: 0.85rem 0 0;
		color: var(--btn-content);
		font-size: 0.9rem;
		line-height: 1.75;
	}

	.game-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 1rem 0 1.2rem;
		color: var(--btn-content);
		font-size: 0.72rem;
		font-weight: 700;
	}

	.meta-rule {
		width: 1.25rem;
		height: 1px;
		background: var(--primary);
	}

	.game-actions {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.game-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-height: 2.5rem;
		padding: 0.55rem 0.85rem;
		border: 1px solid transparent;
		border-radius: 0.55rem;
		font-size: 0.8rem;
		font-weight: 750;
		transition: background 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease;
	}

	.game-action:hover {
		transform: translateY(-1px);
	}

	.game-action-primary {
		color: var(--deep-text);
		background: var(--primary);
	}

	.game-action-primary:hover {
		color: var(--deep-text);
		background: color-mix(in srgb, var(--primary) 84%, white);
	}

	.game-action-secondary {
		color: var(--btn-content);
		border-color: var(--line-divider);
		background: var(--btn-regular-bg);
	}

	.game-action-secondary:hover {
		color: var(--primary);
		border-color: var(--primary);
		background: var(--btn-regular-bg-hover);
	}

	.games-footer {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line-divider);
		color: var(--btn-content);
		font-size: 0.78rem;
	}

	.games-footer > :first-child {
		flex: 0 0 auto;
		color: var(--primary);
	}

	.games-footer p {
		margin: 0;
		flex: 1;
	}

	.games-footer a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		flex: 0 0 auto;
		color: var(--primary);
		font-weight: 750;
	}

	.games-footer a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	@media (max-width: 700px) {
		.games-page {
			padding-inline: 0;
		}

		.games-intro {
			align-items: flex-start;
			padding-bottom: 1.5rem;
		}

		.games-count {
			display: none;
		}

		.game-grid {
			grid-template-columns: 1fr;
			padding-top: 1.5rem;
		}

		.game-description {
			min-height: 0;
		}

		.games-footer {
			align-items: flex-start;
			flex-wrap: wrap;
		}

		.games-footer p {
			flex: 1 1 calc(100% - 2rem);
		}

		.games-footer a {
			margin-left: 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.game-card,
		.game-visual img,
		.game-action {
			transition: none;
		}
	}
</style>
